{
  "compilerOptions": {
    "target": "es5",
    "module": "commonjs",
    "strict": true,
    "noEmitOnError": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "allowJs": true,
    "declaration": true
  },
  "include": [
    "index.ts",
    "transformer.ts",
    "test/tests-compiler/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
